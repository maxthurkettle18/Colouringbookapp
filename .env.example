# Copy to .env and fill in to enable the real (non-mock) pipeline.
# The app runs WITHOUT any keys using a built-in mock generator,
# so you can try the full flow before paying for anything.

# Used by Claude to expand your theme + reference images into strong
# line-art prompts. Without it, a local template builder is used instead.
ANTHROPIC_API_KEY=

# Used to actually generate images (OpenAI gpt-image-1 by default).
# Without it, the mock provider draws placeholder coloring pages so the
# end-to-end pipeline (generate -> clean -> PDF) still works.
OPENAI_API_KEY=

# Which image backend to use: "auto" | "openai" | "mock"
# "auto" uses openai when OPENAI_API_KEY is set, otherwise mock.
IMAGE_PROVIDER=auto

# Server port
PORT=3000
